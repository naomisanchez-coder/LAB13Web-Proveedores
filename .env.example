# Completar solo en .env.local. Nunca publicar las credenciales reales.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secreto-local-con-node-crypto

# PostgreSQL persistente. Pooling en ejecución; conexión directa para migraciones.
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
